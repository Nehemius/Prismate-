# ==============================================================================
# PRISMATE 1.5 — SUPABASE CONFIGURATION
# ==============================================================================
# In your Supabase Dashboard (https://supabase.com/dashboard):
# 1. Open your project.
# 2. Go to Project Settings -> API.
# 3. Copy the "Project URL" and paste below into VITE_SUPABASE_URL.
# 4. Copy the "anon public" key and paste below into VITE_SUPABASE_ANON_KEY.
# ==============================================================================

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
